{
  "uid": "ai-cost-governance",
  "title": "AI Cost & Governance",
  "tags": ["langfuse", "ai", "cost", "governance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Cost over time",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(day, '1d') AS \"time\", SUM(total_cost) AS \"cost\" FROM mrt_org_daily WHERE $__timeFilter(day) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tokens over time",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(day, '1d') AS \"time\", SUM(input_tokens) AS \"in\", SUM(output_tokens) AS \"out\" FROM mrt_org_daily WHERE $__timeFilter(day) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cost by project",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(day, '1d') AS \"time\", project_name AS metric, SUM(total_cost) AS \"value\" FROM mrt_daily_usage WHERE $__timeFilter(day) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cost by model",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(day, '1d') AS \"time\", model AS metric, SUM(total_cost) AS \"value\" FROM mrt_daily_usage WHERE $__timeFilter(day) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache hit rate by model",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(day, '1d') AS \"time\", model AS metric, AVG(cache_hit_rate) AS \"value\" FROM mrt_model_daily WHERE $__timeFilter(day) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cost per 1k tokens by model",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(day, '1d') AS \"time\", model AS metric, AVG(cost_per_1k_tokens) AS \"value\" FROM mrt_model_daily WHERE $__timeFilter(day) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top spenders (users)",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
          "format": "table",
          "rawSql": "SELECT user_id, SUM(total_cost) AS cost, SUM(total_tokens) AS tokens FROM mrt_daily_usage WHERE $__timeFilter(day) GROUP BY user_id ORDER BY cost DESC LIMIT 10"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Model efficiency",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
          "format": "table",
          "rawSql": "SELECT model, cache_hit_rate, reasoning_share, output_input_ratio, cost_per_1k_tokens, total_cost FROM mrt_model_efficiency ORDER BY total_cost DESC"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Behaviour governance — proposals over time",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(day, '1d') AS \"time\", proposals_total AS \"total\", proposals_ratified AS \"ratified\" FROM mrt_governance_daily WHERE $__timeFilter(day) ORDER BY 1"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Ratified policies (canon)",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
          "format": "table",
          "rawSql": "SELECT rule_key, kind, confidence, operator, evidence_traces, promoted_at FROM dim_policy ORDER BY rule_key"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Decision divergence by model × task",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
          "format": "table",
          "rawSql": "SELECT model, task_key, divergent_traces, total_traces, ROUND(divergent_traces::numeric / NULLIF(total_traces, 0)::numeric, 4) AS divergence_ratio FROM fact_governance_divergence ORDER BY model, task_key"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Policy coverage (traces)",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "warehouse" },
          "format": "table",
          "rawSql": "SELECT ratified_policies, evidence_traces, total_traces, coverage_ratio FROM mrt_policy_coverage"
        }
      ]
    }
  ]
}
