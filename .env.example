# ===========================================================================
# Langfuse source (self-hosted).
#
# LANGFUSE_MODE:
#   api        -> pull from the Langfuse public REST API (version-safe default).
#   clickhouse -> read Langfuse's own ClickHouse directly (fastest; column
#                 names vary by Langfuse release — see extractor/clickhouse_client.py).
# ===========================================================================
LANGFUSE_MODE=api
LANGFUSE_BASE_URL=http://host.docker.internal:3000

# ---- Multi-project roll-up (api mode) -------------------------------------
# Provide one entry per Langfuse project. `public_key` is the Langfuse API
# "public key" (pk-lf-...), `secret_key` the "secret key" (sk-lf-...).
# LANGFUSE_PROJECTS='[
#   {"id":"app-assistant","name":"App Assistant","public_key":"pk-lf-...","secret_key":"sk-lf-..."},
#   {"id":"codegen","name":"Code Generation","public_key":"pk-lf-...","secret_key":"sk-lf-..."}
# ]'
#
# ---- Single-project shorthand (used only when LANGFUSE_PROJECTS is unset) --
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=my-project
LANGFUSE_PROJECT_NAME=My Project

# ---- ClickHouse source mode only -------------------------------------------
LANGFUSE_CLICKHOUSE_URL=http://host.docker.internal:8123
LANGFUSE_CLICKHOUSE_USER=default
LANGFUSE_CLICKHOUSE_PASSWORD=

# ===========================================================================
# Analytics warehouse (where KPIs are computed).
#   postgresql://user:pass@host:5432/db    (default; server)
#   duckdb:///data/analytics.duckdb        (embedded, zero-server)
#   clickhouse://user:pass@host:8123/db    (server, for scale)
# In Docker Compose this is set per-compose-file; set it here only when
# running the services outside Docker.
# ===========================================================================
DATABASE_URL=postgresql://analytics:analytics@localhost:5433/analytics

# ===========================================================================
# Extractor behaviour
# ===========================================================================
LOOKBACK_DAYS=30
SYNC_INTERVAL_SECONDS=300
BATCH_SIZE=1000

# ===========================================================================
# Serving & exposure
#
# BIND_HOST: host interface the Compose port mappings bind to. Defaults to
#   loopback so a fresh `docker compose up` is not reachable from the network.
#   Set to 0.0.0.0 to expose the stack (put authentication in front of it
#   first: the API has none of its own).
# CORS_ALLOW_ORIGINS: comma-separated origins allowed to call the API from a
#   browser. Empty (the default) disables CORS entirely, which is correct for
#   the bundled topology where nginx proxies /api/ to the API on one origin.
#   Only needed when the dashboard is served from a different host than the
#   API (see docs/topologies.md).
# VITE_API_BASE: build-time API base URL for the React bundle. Empty (the
#   default) makes the dashboard call its own origin through the nginx proxy.
# ===========================================================================
BIND_HOST=127.0.0.1
CORS_ALLOW_ORIGINS=
VITE_API_BASE=

# ===========================================================================
# Grafana (docker-compose.grafana.yml)
# ===========================================================================
GRAFANA_ADMIN_PASSWORD=admin

# ===========================================================================
# DeepSeek Harness (DSH) ingestion — optional, `--profile dsh`
#
# DSH_SESSIONS_DIR: where DSH writes its session logs.
# DSH_USER_ID: label the ingested spend is attributed to. DSH logs carry no
#   user identity, so this is a free-text label, not an identifier.
# DSH_PROJECT_PREFIX: strip this literal prefix from slugified session
#   directory names. Leave unset to strip a leading `home-<user>-` segment.
# ===========================================================================
DSH_SESSIONS_DIR=~/.dsh/sessions
DSH_USER_ID=local
DSH_INGEST_INTERVAL_SECONDS=300

# ===========================================================================
# canon (behaviour governance) ingestion
#
# canon (github.com/ClemenceChee/canon) writes `canon export --format json`
# documents here; the canon-ingest sidecar polls this directory and upserts
# them into the behaviour-governance tables. See docs/canon-integration.md.
# ===========================================================================
CANON_EXPORT_DIR=./canon-state
CANON_INGEST_INTERVAL_SECONDS=300
